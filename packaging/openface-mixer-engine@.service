# Installed by scripts/install.sh, which fills in the full path of the command.
[Unit]
Description=Openface Mixer engine for the %i (drives its hardware mixer)
# The mix needs no PipeWire: the engine restores it without, and makes the desktop's sinks
# and sources whenever PipeWire runs, also after PipeWire restarts.
Wants=pipewire.service
After=pipewire.service wireplumber.service

[Service]
ExecStart="@BINDIR@/openface-mixer-engine" --device %i
Restart=on-failure
RestartSec=2
# 3: another engine already runs for the device
RestartPreventExitStatus=3

[Install]
WantedBy=default.target

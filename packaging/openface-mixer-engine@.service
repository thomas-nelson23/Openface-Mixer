# Installed by scripts/install.sh, which fills in the full path of the command.
[Unit]
Description=Openface Mixer engine for the %i (drives its hardware mixer)
After=pipewire.service wireplumber.service
Requires=pipewire.service

[Service]
ExecStart="@BINDIR@/openface-mixer-engine" --device %i
Restart=on-failure
RestartSec=2

[Install]
WantedBy=pipewire.service

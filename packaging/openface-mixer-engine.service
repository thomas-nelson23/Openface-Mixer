# Installed by scripts/install.sh, which fills in the full path of the command.
[Unit]
Description=Openface Mixer engine (drives the RME Digiface USB hardware mixer)
After=pipewire.service wireplumber.service
Requires=pipewire.service

[Service]
ExecStart="@BINDIR@/openface-mixer-engine"
Restart=on-failure
RestartSec=2
# 3: another engine already runs for the device
RestartPreventExitStatus=3

[Install]
WantedBy=pipewire.service

# Installed by scripts/install.sh, which fills in the full path of the command.
[Unit]
Description=Openface Mixer engine (drives the RME Digiface USB hardware mixer)
# The mix needs no PipeWire: the engine restores it without, and makes the desktop's sinks
# and sources whenever PipeWire runs, also after PipeWire restarts. No Wants= either, so that
# a setup that keeps PipeWire off (JACK alone) does not get it started at login.
After=pipewire.service wireplumber.service

[Service]
ExecStart="@BINDIR@/openface-mixer-engine"
Restart=on-failure
RestartSec=2
# 3: another engine already runs for the device
RestartPreventExitStatus=3

[Install]
WantedBy=default.target
